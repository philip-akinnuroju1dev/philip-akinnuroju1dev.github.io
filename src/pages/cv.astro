---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section class="cv-hero">
		<p class="eyebrow">Curriculum Vitae</p>

		<h1>IT support, cybersecurity and data-focused experience.</h1>

		<p class="intro">
			ICT professional with hands-on experience supporting hardware,
			software and enterprise systems, with a developing specialism in
			cybersecurity, infrastructure, data analytics and technical research.
		</p>

		<div class="cv-actions">
			<a class="primary-button" href="#experience">View Experience</a>
			<a class="secondary-button" href="/contact">Contact Me</a>
		</div>
	</section>

	<section class="cv-section" id="experience">
		<div class="section-title">
			<p class="eyebrow">Career</p>
			<h2>Professional Experience</h2>
		</div>

		<div class="timeline">

			<article class="timeline-item">
				<div class="timeline-heading">
					<div>
						<h3>IT Support Analyst</h3>
						<p class="organisation">Rhubtech · Remote</p>
					</div>

					<p class="date">July 2025 – Present</p>
				</div>

				<ul>
					<li>
						Provide first-line support across hardware, software and
						system issues, resolving incidents where possible and
						escalating more complex cases.
					</li>

					<li>
						Log, update and monitor incidents and service requests
						using SolarWinds Service Desk.
					</li>

					<li>
						Maintain user accounts, permissions and IT asset records
						using Active Directory.
					</li>

					<li>
						Prepare statistical reports and spreadsheets to support
						management decision-making and identify recurring issues.
					</li>

					<li>
						Perform routine system and equipment checks using
						structured troubleshooting and good data-protection
						practice.
					</li>
				</ul>

				<div class="tags">
					<span>Active Directory</span>
					<span>SolarWinds</span>
					<span>IT Support</span>
					<span>Incident Management</span>
					<span>Troubleshooting</span>
				</div>
			</article>

			<article class="timeline-item">
				<div class="timeline-heading">
					<div>
						<h3>IT Security Analyst (Trainee)</h3>
						<p class="organisation">Optima-IT · United Kingdom</p>
					</div>

					<p class="date">June 2022 – June 2025</p>
				</div>

				<ul>
					<li>
						Supported system and security-alert monitoring to help
						identify and triage potential security issues.
					</li>

					<li>
						Assisted with logging and tracking security-related
						incidents while maintaining clear documentation.
					</li>

					<li>
						Supported access-control management and security good
						practice across systems.
					</li>

					<li>
						Developed practical security knowledge around system
						protection, confidentiality and data protection.
					</li>
				</ul>

				<div class="tags">
					<span>Security Monitoring</span>
					<span>Incident Triage</span>
					<span>Access Control</span>
					<span>Cybersecurity</span>
					<span>Documentation</span>
				</div>
			</article>

		</div>
	</section>

	<section class="cv-section">
		<div class="section-title">
			<p class="eyebrow">Academic Background</p>
			<h2>Education</h2>
		</div>

		<div class="education-grid">

			<article class="education-card">
				<p class="degree-type">Master's Degree</p>
				<h3>MSc International Business with Data Analytics</h3>
				<p>Ulster University</p>
				<p class="location">United Kingdom · 2022</p>
			</article>

			<article class="education-card">
				<p class="degree-type">Master's Degree</p>
				<h3>MSc Cybersecurity and Digital Forensics</h3>
				<p>De Montfort University</p>
				<p class="location">United Kingdom · 2020</p>
			</article>

			<article class="education-card">
				<p class="degree-type">Bachelor's Degree</p>
				<h3>B.Tech Industrial Mathematics</h3>
				<p>Federal University of Technology, Akure</p>
				<p class="location">Nigeria · 2016</p>
			</article>

		</div>
	</section>

	<section class="cv-section">
		<div class="section-title">
			<p class="eyebrow">Technical Skills</p>
			<h2>Core Technologies</h2>
		</div>

		<div class="skills-grid">

			<div class="skill-group">
				<h3>IT Support & Infrastructure</h3>

				<div class="tags">
					<span>Active Directory</span>
					<span>Microsoft Windows</span>
					<span>Microsoft Exchange</span>
					<span>Microsoft Office</span>
					<span>PowerShell</span>
					<span>SolarWinds Service Desk</span>
					<span>Troubleshooting</span>
				</div>
			</div>

			<div class="skill-group">
				<h3>Cybersecurity</h3>

				<div class="tags">
					<span>Security Monitoring</span>
					<span>Incident Triage</span>
					<span>Access Control</span>
					<span>Data Protection</span>
					<span>Wazuh</span>
					<span>Sysmon</span>
					<span>Wireshark</span>
				</div>
			</div>

			<div class="skill-group">
				<h3>Data & Analytics</h3>

				<div class="tags">
					<span>Data Analytics</span>
					<span>Statistical Reporting</span>
					<span>Spreadsheets</span>
					<span>Statistics</span>
				</div>
			</div>

			<div class="skill-group">
				<h3>Professional Practice</h3>

				<div class="tags">
					<span>Incident Management</span>
					<span>Service Desk</span>
					<span>Technical Documentation</span>
					<span>Customer Support</span>
					<span>Problem Solving</span>
				</div>
			</div>

		</div>
	</section>

	<section class="cv-section">
		<div class="section-title">
			<p class="eyebrow">Professional Development</p>
			<h2>Certifications</h2>
		</div>

		<div class="certifications">

			<article class="certification">
				<div class="cert-heading">
					<h3>CompTIA Network+</h3>
					<span class="status completed">Completed</span>
				</div>

				<p>Networking concepts, infrastructure, operations and troubleshooting.</p>
				<p class="cert-date">2023</p>
			</article>

			<article class="certification">
				<div class="cert-heading">
					<h3>ITIL 4 Foundation</h3>
					<span class="status completed">Completed</span>
				</div>

				<p>
					IT service management principles, service delivery and
					continual improvement.
				</p>
				<p class="cert-date">2023</p>
			</article>

			<article class="certification">
				<div class="cert-heading">
					<h3>CompTIA Security+</h3>
					<span class="status progress">In Progress</span>
				</div>

				<p>
					Developing knowledge across security operations, threats,
					architecture, risk and incident response.
				</p>
			</article>

		</div>
	</section>

	<section class="download-section">

		<div>
			<p class="eyebrow">Full CV</p>
			<h2>Download my CV</h2>

			<p>
				Download the complete PDF version for additional professional
				and employment information.
			</p>
		</div>

		<a
	class="download-button"
	href="/Philip_Akinnuroju_CV.pdf"
	download
>
	Download CV ↓
</a>

	</section>
</Layout>

<style>
	.cv-hero {
		max-width: 900px;
		padding: 4rem 0 5rem;
	}

	.cv-hero h1 {
		margin: 1rem 0 1.5rem;
		font-size: clamp(3rem, 6vw, 5rem);
		line-height: 1.05;
		letter-spacing: -0.04em;
	}

	.intro {
		max-width: 760px;
		color: #aeb8cc;
		font-size: 1.2rem;
	}

	.cv-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}

	.cv-section,
	.download-section {
		padding: 4rem 0;
		border-top: 1px solid #25304a;
	}

	.section-title {
		margin-bottom: 2rem;
	}

	.section-title h2,
	.download-section h2 {
		margin: 0.5rem 0 0;
		font-size: 2rem;
	}

	.timeline {
		display: grid;
		gap: 1.25rem;
	}

	.timeline-item,
	.education-card,
	.skill-group,
	.certification {
		padding: 1.6rem;
		border: 1px solid #25304a;
		border-radius: 12px;
		background: #10172a;
	}

	.timeline-heading,
	.cert-heading {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1.5rem;
	}

	.timeline-item h3,
	.education-card h3,
	.skill-group h3,
	.certification h3 {
		margin-top: 0;
	}

	.timeline-item ul {
		padding-left: 1.25rem;
		color: #aeb8cc;
		line-height: 1.8;
	}

	.organisation,
	.degree-type {
		color: #7dd3fc !important;
		font-size: 0.85rem;
		font-weight: 600;
	}

	.date,
	.location,
	.cert-date {
		color: #8894aa;
		font-size: 0.9rem;
	}

	.education-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.education-card p,
	.certification p {
		color: #aeb8cc;
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.certifications {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.status {
		flex-shrink: 0;
		padding: 0.25rem 0.55rem;
		border: 1px solid #35415d;
		border-radius: 999px;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.status.completed {
		color: #7dd3fc;
	}

	.status.progress {
		color: #facc15;
	}

	.download-section {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
	}

	.download-section p {
		max-width: 650px;
		color: #aeb8cc;
	}

	.download-button {
	flex-shrink: 0;
	display: inline-block;
	padding: 0.8rem 1.2rem;
	border-radius: 8px;
	background: #e8edf7;
	color: #0b1020;
	font-weight: 700;
	text-decoration: none;
	transition:
		transform 0.2s ease,
		opacity 0.2s ease;
}

.download-button:hover {
	transform: translateY(-2px);
	opacity: 0.9;
}

	@media (max-width: 900px) {
		.education-grid,
		.certifications {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 750px) {
		.skills-grid {
			grid-template-columns: 1fr;
		}

		.timeline-heading,
		.cert-heading {
			flex-direction: column;
			gap: 0.25rem;
		}

		.download-section {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>