---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section class="hero">
		<p class="eyebrow">
			IT Infrastructure · Cybersecurity · Data Analytics · Applied Research
		</p>

		<h1>
			Building practical skills through systems, security, data and research.
		</h1>

		<p class="intro">
			I'm Philip Akinnuroju, an ICT and cybersecurity professional with
			a multidisciplinary background in Industrial Mathematics,
			Cybersecurity and Digital Forensics, and Data Analytics. This
			portfolio documents my technical projects, hands-on labs, research,
			programming exercises and continuous professional development.
		</p>

		<div class="hero-actions">
			<a class="primary-button" href="/portfolio">Explore My Work</a>
			<a class="secondary-button" href="/about">About Me</a>
		</div>
	</section>

	<section class="areas">
		<h2>Areas of Work</h2>

		<div class="card-grid">
			<a class="card" href="/labs">
				<p class="card-label">Infrastructure & Security</p>
				<h3>IT & Cybersecurity Labs</h3>
				<p>
					Active Directory, Windows environments, SIEM, endpoint
					monitoring, network analysis, incident investigation and
					defensive security exercises.
				</p>
			</a>

			<a class="card" href="/portfolio">
				<p class="card-label">Programming & Analytics</p>
				<h3>Python, R & Data</h3>
				<p>
					Programming exercises, statistical analysis, automation,
					data visualisation and practical analytical projects.
				</p>
			</a>

			<a class="card" href="/research">
				<p class="card-label">Applied Research</p>
				<h3>AI & Cybersecurity</h3>
				<p>
					Research interests spanning security analytics, endpoint
					telemetry, explainable AI and graph-based approaches to
					cybersecurity problems.
				</p>
			</a>
		</div>
	</section>

	<section class="featured">
		<div class="section-heading">
			<div>
				<p class="eyebrow">Portfolio Development</p>
				<h2>Current Technical Focus</h2>
			</div>

			<a href="/portfolio">Explore portfolio →</a>
		</div>

		<div class="project-grid">
			<article class="project">
				<p class="project-type">Cybersecurity</p>
				<h3>Endpoint Threat Detection</h3>
				<p>
					Developing hands-on investigations using endpoint telemetry,
					SIEM tooling and controlled security scenarios, with findings
					and evidence documented as the work progresses.
				</p>

				<div class="tags">
					<span>Wazuh</span>
					<span>Sysmon</span>
					<span>Wireshark</span>
				</div>
			</article>

			<article class="project">
				<p class="project-type">Infrastructure</p>
				<h3>Windows & Active Directory</h3>
				<p>
					Building and documenting Windows infrastructure exercises
					covering identity, Group Policy, permissions, administration
					and troubleshooting.
				</p>

				<div class="tags">
					<span>Active Directory</span>
					<span>Windows Server</span>
					<span>Group Policy</span>
				</div>
			</article>

			<article class="project">
				<p class="project-type">Learning & Research</p>
				<h3>Security, Data & AI</h3>
				<p>
					Developing Python and R skills while exploring how data
					analytics, machine learning and interpretable methods can be
					applied to cybersecurity.
				</p>

				<div class="tags">
					<span>Python</span>
					<span>R</span>
					<span>Security Analytics</span>
				</div>
			</article>
		</div>
	</section>
</Layout>

<style>
	.hero {
		max-width: 850px;
		padding: 5rem 0 6rem;
	}

	.eyebrow {
		color: #7dd3fc;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.hero h1 {
		margin: 1rem 0 1.5rem;
		font-size: clamp(3rem, 7vw, 5.8rem);
		line-height: 1.02;
		letter-spacing: -0.05em;
	}

	.intro {
		max-width: 720px;
		color: #aeb8cc;
		font-size: 1.2rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		margin-top: 2rem;
		flex-wrap: wrap;
	}

	.primary-button,
	.secondary-button {
		padding: 0.8rem 1.2rem;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 600;
	}

	.primary-button {
		background: #e8edf7;
		color: #0b1020;
	}

	.secondary-button {
		border: 1px solid #35415d;
		color: #e8edf7;
	}

	.areas,
	.featured {
		padding: 4rem 0;
		border-top: 1px solid #25304a;
	}

	h2 {
		font-size: 2rem;
		margin-bottom: 2rem;
	}

	.card-grid,
	.project-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.card,
	.project {
		padding: 1.6rem;
		border: 1px solid #25304a;
		border-radius: 12px;
		background: #10172a;
	}

	.card {
		text-decoration: none;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: #52617f;
	}

	.card-label,
	.project-type {
		margin: 0 0 0.6rem;
		color: #7dd3fc;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.card h3,
	.project h3 {
		margin: 0 0 0.75rem;
		font-size: 1.3rem;
	}

	.card p,
	.project p {
		color: #aeb8cc;
	}

	.card .card-label,
	.project .project-type {
		color: #7dd3fc;
	}

	.section-heading {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.section-heading h2 {
		margin: 0;
	}

	.section-heading a {
		color: #aeb8cc;
		text-decoration: none;
	}

	.tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-top: 1.2rem;
	}

	.tags span {
		padding: 0.3rem 0.6rem;
		border: 1px solid #35415d;
		border-radius: 999px;
		color: #aeb8cc;
		font-size: 0.75rem;
	}

	@media (max-width: 850px) {
		.card-grid,
		.project-grid {
			grid-template-columns: 1fr;
		}

		.hero {
			padding-top: 2rem;
		}

		.section-heading {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>