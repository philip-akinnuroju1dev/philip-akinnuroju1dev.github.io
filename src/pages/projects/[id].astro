---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');

	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;

const { Content } = await render(project);
---

<Layout>
	<article class="project-page">
		<a class="back-link" href="/portfolio">← Back to Portfolio</a>

		<header class="project-header">
			<div class="project-meta">
				<span>{project.data.category}</span>
				<span>{project.data.status}</span>
			</div>

			<h1>{project.data.title}</h1>

			<p class="description">
				{project.data.description}
			</p>

			<div class="tags">
				{
					project.data.tags.map((tag) => (
						<span>{tag}</span>
					))
				}
			</div>
		</header>

		<div class="project-content">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.project-page {
		max-width: 900px;
		margin: 0 auto;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 3rem;
		color: #aeb8cc;
		text-decoration: none;
	}

	.back-link:hover {
		color: #ffffff;
	}

	.project-header {
		padding-bottom: 3rem;
		border-bottom: 1px solid #25304a;
	}

	.project-meta {
		display: flex;
		gap: 0.75rem;
		margin-bottom: 1.2rem;
	}

	.project-meta span {
		padding: 0.3rem 0.65rem;
		border: 1px solid #35415d;
		border-radius: 999px;
		color: #7dd3fc;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.project-header h1 {
		margin: 0 0 1.5rem;
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: 1.05;
		letter-spacing: -0.04em;
	}

	.description {
		max-width: 750px;
		color: #aeb8cc;
		font-size: 1.15rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.5rem;
	}

	.tags span {
		padding: 0.3rem 0.6rem;
		border: 1px solid #35415d;
		border-radius: 999px;
		color: #aeb8cc;
		font-size: 0.8rem;
	}

	.project-content {
		padding: 3rem 0;
	}

	.project-content :global(h1) {
		display: none;
	}

	.project-content :global(h2) {
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		font-size: 1.8rem;
	}

	.project-content :global(h3) {
		margin-top: 2rem;
		font-size: 1.3rem;
	}

	.project-content :global(p),
	.project-content :global(li) {
		color: #b8c2d6;
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.project-content :global(ul),
	.project-content :global(ol) {
		padding-left: 1.5rem;
	}

	.project-content :global(code) {
		padding: 0.2rem 0.35rem;
		border-radius: 5px;
		background: #151e33;
	}

	.project-content :global(pre) {
		overflow-x: auto;
		padding: 1rem;
		border: 1px solid #25304a;
		border-radius: 10px;
		background: #10172a;
	}
</style>