---
import '../styles/global.css';

const currentPath =
	Astro.url.pathname !== '/'
		? Astro.url.pathname.replace(/\/$/, '')
		: '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<meta
			name="description"
			content="Philip Akinnuroju's technical portfolio covering cybersecurity, data analytics, AI, research, labs and continuous learning."
		/>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<title>Philip Akinnuroju | Technical Portfolio</title>
	</head>

	<body>
		<header class="site-header">
			<div class="nav-container">

				<a class="brand" href="/">
					<span class="brand-name">Philip Akinnuroju</span>
					<span class="brand-role">Technical Portfolio</span>
				</a>

				<button
					class="menu-button"
					type="button"
					aria-label="Open navigation"
					aria-expanded="false"
					aria-controls="main-navigation"
				>
					<span></span>
					<span></span>
					<span></span>
				</button>

				<nav
					id="main-navigation"
					class="main-nav"
					aria-label="Main navigation"
				>
					<a
						class:list={[{ active: currentPath === '/' }]}
						href="/"
					>
						Home
					</a>

					<a
						class:list={[{ active: currentPath === '/about' }]}
						href="/about"
					>
						About
					</a>

					<a
						class:list={[
							{
								active:
									currentPath === '/portfolio' ||
									currentPath.startsWith('/projects/')
							}
						]}
						href="/portfolio"
					>
						Portfolio
					</a>

					<a
						class:list={[
							{
								active: currentPath.startsWith('/labs')
							}
						]}
						href="/labs"
					>
						Labs
					</a>

					<a
						class:list={[
							{
								active: currentPath.startsWith('/research')
							}
						]}
						href="/research"
					>
						Research
					</a>

					<a
						class:list={[
							{
								active:
									currentPath === '/journal' ||
									currentPath.startsWith('/journals/')
							}
						]}
						href="/journal"
					>
						Journal
					</a>

					<a
						class:list={[{ active: currentPath === '/cv' }]}
						href="/cv"
					>
						CV
					</a>

					<a
						class:list={[{ active: currentPath === '/contact' }]}
						href="/contact"
					>
						Contact
					</a>
				</nav>

			</div>
		</header>

		<main class="page-shell">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-container">

				<div>
					<p class="footer-name">Philip Akinnuroju</p>
					<p class="footer-description">
						Cybersecurity · Data Analytics · AI & Research
					</p>
				</div>

				<p class="copyright">
					© 2026 Philip Akinnuroju
				</p>

			</div>
		</footer>

		<script>
			const menuButton = document.querySelector('.menu-button');
			const navigation = document.querySelector('.main-nav');

			menuButton?.addEventListener('click', () => {
				const isOpen = navigation?.classList.toggle('open');

				menuButton.setAttribute(
					'aria-expanded',
					isOpen ? 'true' : 'false'
				);
			});

			navigation?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					navigation.classList.remove('open');
					menuButton?.setAttribute('aria-expanded', 'false');
				});
			});
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		background: #0b1020;
	}

	:global(body) {
		margin: 0;
		min-width: 320px;
		font-family:
			Inter,
			ui-sans-serif,
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
		background: #0b1020;
		color: #e8edf7;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	:global(a) {
		color: inherit;
	}

	:global(::selection) {
		background: #7dd3fc;
		color: #0b1020;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		width: 100%;
		background: rgba(11, 16, 32, 0.94);
		border-bottom: 1px solid #25304a;
		backdrop-filter: blur(14px);
	}

	.nav-container {
		width: min(1200px, calc(100% - 3rem));
		min-height: 76px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.brand {
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		text-decoration: none;
		line-height: 1.2;
	}

	.brand-name {
		font-size: 1rem;
		font-weight: 750;
		letter-spacing: -0.01em;
	}

	.brand-role {
		margin-top: 0.25rem;
		color: #7f8ba3;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.main-nav {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}

	.main-nav a {
		position: relative;
		padding: 0.65rem 0.7rem;
		border-radius: 7px;
		color: #9ca8bd;
		font-size: 0.88rem;
		font-weight: 500;
		text-decoration: none;
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}

	.main-nav a:hover {
		color: #ffffff;
		background: #121a2d;
	}

	.main-nav a.active {
		color: #ffffff;
	}

	.main-nav a.active::after {
		content: "";
		position: absolute;
		right: 0.7rem;
		bottom: 0.35rem;
		left: 0.7rem;
		height: 2px;
		border-radius: 999px;
		background: #7dd3fc;
	}

	.menu-button {
		display: none;
		width: 42px;
		height: 42px;
		padding: 9px;
		border: 1px solid #35415d;
		border-radius: 8px;
		background: transparent;
		cursor: pointer;
	}

	.menu-button span {
		display: block;
		width: 100%;
		height: 2px;
		margin: 4px 0;
		border-radius: 999px;
		background: #e8edf7;
	}

	.page-shell {
		width: min(1200px, calc(100% - 3rem));
		min-height: calc(100vh - 170px);
		margin: 0 auto;
		padding: 2rem 0 5rem;
	}

	.site-footer {
		border-top: 1px solid #25304a;
		background: #090e1b;
	}

	.footer-container {
		width: min(1200px, calc(100% - 3rem));
		margin: 0 auto;
		padding: 2.5rem 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.footer-name {
		margin: 0;
		font-weight: 700;
	}

	.footer-description,
	.copyright {
		margin: 0.35rem 0 0;
		color: #7f8ba3;
		font-size: 0.85rem;
	}

	@media (max-width: 950px) {
		.menu-button {
			display: block;
		}

		.nav-container {
			position: relative;
		}

		.main-nav {
			position: absolute;
			top: calc(100% + 1px);
			right: 0;
			left: 0;
			display: none;
			padding: 0.75rem;
			flex-direction: column;
			align-items: stretch;
			gap: 0.25rem;
			border: 1px solid #25304a;
			border-top: none;
			border-radius: 0 0 12px 12px;
			background: #0d1425;
			box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
		}

		.main-nav.open {
			display: flex;
		}

		.main-nav a {
			padding: 0.85rem 1rem;
		}

		.main-nav a.active::after {
			top: 50%;
			right: auto;
			bottom: auto;
			left: 0.25rem;
			width: 2px;
			height: 20px;
			transform: translateY(-50%);
		}
	}

	@media (max-width: 600px) {
		.nav-container,
		.page-shell,
		.footer-container {
			width: min(100% - 2rem, 1200px);
		}

		.page-shell {
			padding-top: 1rem;
			padding-bottom: 4rem;
		}

		.footer-container {
			align-items: flex-start;
			flex-direction: column;
		}

		.brand-role {
			display: none;
		}
	}
</style>